{
  "$schema": "templprj neutral kit tokens, v1",
  "meta": {
    "chroma": 0,
    "note": "REPLACE-marked groups are the seams a venture fills from its brand. See kit.md."
  },
  "grey": {
    "0": "#ffffff",
    "50": "#f7f7f7",
    "100": "#ededed",
    "200": "#dcdcdc",
    "300": "#c4c4c4",
    "400": "#a3a3a3",
    "500": "#808080",
    "600": "#616161",
    "700": "#474747",
    "800": "#2e2e2e",
    "900": "#1a1a1a",
    "1000": "#000000"
  },
  "accent": {
    "base": "grey.500",
    "fg": "grey.0",
    "replace": true
  },
  "surface": {
    "bg": "grey.0",
    "bgInverse": "grey.900",
    "fg": "grey.900",
    "fgInverse": "grey.0",
    "fgMuted": "grey.700",
    "fgSubtle": "grey.600",
    "fgPlaceholder": "grey.600",
    "line": "grey.300",
    "lineStrong": "grey.200"
  },
  "font": {
    "text": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, monospace",
    "replace": true,
    "weights": {
      "regular": 400,
      "strong": 600
    }
  },
  "text": {
    "xs": 13,
    "sm": 16,
    "md": 20,
    "lg": 25,
    "xl": 31,
    "2xl": 39,
    "3xl": 49,
    "4xl": 61,
    "5xl": 76,
    "6xl": 95,
    "7xl": 119,
    "ratio": 1.25,
    "base": 16,
    "unit": "px"
  },
  "floor": {
    "slide": "24px",
    "print": "12pt"
  },
  "leading": {
    "tight": 1.1,
    "body": 1.4
  },
  "measure": "68ch",
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "6": 24,
    "8": 32,
    "12": 48,
    "16": 64,
    "24": 96,
    "unit": "px"
  },
  "radius": 0,
  "shadow": "none",
  "motion": {
    "duration": "120ms",
    "easing": "linear"
  },
  "contrast": {
    "target": "WCAG 2.2 AA",
    "bodyOnLight": [
      "grey.700",
      "grey.800",
      "grey.900",
      "grey.1000"
    ],
    "secondaryOnLight": [
      "grey.600"
    ],
    "bodyOnDark": [
      "grey.0",
      "grey.50",
      "grey.100"
    ],
    "neverCarriesText": [
      "grey.100",
      "grey.200",
      "grey.300",
      "grey.400",
      "grey.500"
    ]
  },
  "prohibited": [
    "colour-transition gradients",
    "border radius",
    "box shadow",
    "any hue (chroma > 0)",
    "webfonts",
    "more than two weights",
    "drawn illustration",
    "photography",
    "icons beyond geometric primitives",
    "animation beyond 120ms opacity or position",
    "more than one background value per page",
    "letterspacing, small caps, italics outside prose quotation"
  ]
}
