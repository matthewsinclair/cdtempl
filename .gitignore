# Test output and scratch.
tmp/

# Scratch ventures for exercising the loop end to end. Each one is its own git
# repository -- `cdtempl new` inits it -- so tracking them here would nest a repo
# inside this one and the contents would not version either way. Same convention
# as the underscore-prefixed directories under templates/claude_design/.
templates/_test/

# macOS Finder droppings. `Icon?` rather than `Icon` because the real filename
# is Icon followed by a carriage return -- the glob avoids putting a
# non-printing character in this file to match it.
.DS_Store
Icon?

# Per-developer Claude Code settings (paths and tool allowlists vary).
.claude/settings.local.json

# AGENTS.md regeneration safety net (intent agents sync writes this; transient).
/AGENTS.md.bak

# `intent upgrade` writes a timestamped snapshot of everything it is about to
# rewrite. It is a safety net for the upgrade run, not project history -- git
# already holds the previous state, so committing it stores every tracked doc twice.
.backup/

# Release tarballs, built from a tag by `cdtempl release cut`. Regenerable;
# git already holds every tagged state they are built from.
dist/

# Treeindex cache (derived, machine-local; regenerate with 'intent treeindex <dir>').
intent/.treeindex/

# The Intent runtime store: per-machine, rebuilt from the committed extract.
intent/.cache/

# D53: the event log lives in the store; its file form is produced by `intent export`.
intent/.backup/

# bin/.devbin/manifest.sha256 WAS IGNORED HERE AND NO LONGER IS (2026-09-22).
# The reason was real when written on 2026-09-15 against devbin 0.1.1: the
# manifest recorded `# source: <absolute path>` of the devbin it came from, a
# home directory, in a repository that publishes on push. devbin issue 0069
# fixed that -- `home_relative` in lib/helpers now writes `~/Devel/opt/devbin`
# -- and the ignore had been obsolete ever since with nothing to say so. Across
# the twelve other estates the tracked manifest carries zero home-shaped lines.
#
# It is tracked now because ignoring it EXEMPTED it from the check that matters.
# `home_relative` still emits an absolute path when HOME is empty or the source
# lies outside it, so the hazard is conditional rather than gone -- and an
# untracked file is invisible to AT-00.6, which greps every TRACKED file for a
# home path. Hiding the one file that could carry one is the weaker guard.
# Tracking it also restores `bin/devbin doctor` on a fresh clone, which used to
# report the manifest missing. The release archive is unaffected either way:
# .gitattributes export-ignores `bin/.devbin/` entirely.
