# What a release tarball may not contain.
#
# `cdsync release cut` builds the tarball with `git archive` from the tag, so
# this file -- not a list inside lib/cmd_release.sh -- decides what ships. One
# list, read by the tool that does the work.
#
# The rule: a release carries the tool, and nothing about how the tool is made.
# intent/ is the project's own working record, test/ is the contract rather than
# the product, and .github/ and .claude/ are how it is built and driven.
intent/         export-ignore
test/           export-ignore
.github/        export-ignore
.claude/        export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore

# The agent contract and the Intent development furniture. These describe how
# Cdsync is built and reviewed, which is the same reason intent/ is excluded --
# a release carries the tool, not the workshop.
AGENTS.md          export-ignore
CLAUDE.md          export-ignore
usage-rules.md     export-ignore
.intent_critic.yml export-ignore
design/            export-ignore

# The dev launcher and its vendored runtime. devbin drives the development of
# Cdsync -- `bin/cdsync` is the tool -- so it is workshop, not product, and it
# shares `bin/` with the one thing a release must carry. The archive test pins
# `bin/` one level down for exactly that reason.
bin/devbin         export-ignore
bin/.devbin/       export-ignore
